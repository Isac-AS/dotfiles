;; ============
;; Variables
;; ============
(defvar eww-command "~/repos/eww/eww/target/release/eww")

(defpoll current-time
	 :interval "30s"
	 `date +%H:%M`)
(defpoll routine-file-json
         :interval "20h"
         "cat ~/.config/eww/routines.json")
(defpoll current-routine
	 :interval "24h"
	 "~/.config/eww/scripts/init-routine.py")
(defpoll current-task
	 :interval "15m"
	 "~/.config/eww/scripts/current-task.py")

;; ============
;; Widgets
;; ============
(defwidget routine-box []
  (box :orientation "h"
       :class "routine-box"
       (routine-info-box)
       (routine-task-list)))

;; Routine info box widgets
(defwidget routine-info-box []
           (box :orientation "v"
		:class "routine-info-box"
		(box :orientation "h"
		     :class "with-border"
		     (box :orientation "v"
			  (label :text "Current routine"
				 :class "magenta bb")
			  (label :text "Default for"
				 :class "blue bb")
			  (label :text "Switch routine"
				 :class "red bb")
			  (label :text "Current task"
				 :class "green"))
		     (box :orientation "v"
			  (label :text "${current-routine.ROUTINE-NAME}"
				 :class "magenta bb")
			  (label :text "${current-routine.DEFAULT-DAYS}"
				 :class "blue bb")
			  (routine-switching-buttons)
			  (label :text "${current-task.Task}"
				 :class "green")))
                (label :text "${current-time}" :class "current-time")
                (calendar :show-details "true"
			  :show-week-numbers "true"
			  :class "calendar-item calendar")))

(defwidget routine-switching-buttons []
           (box :orientation "horizontal"
		:class "routine-switching-buttons bb"
                (for entry in {routine-file-json}
                     (button :onclick "${eww-command} update current-routine='${entry}'"
			     :class "routine-btn"
                             (label :text "${entry.EMOJI}")
                     ))))

;; Routine task list
(defwidget routine-task-list []
           (box :orientation "v"
                :class "routine-task-list"
		(for row in {current-routine.table}
		     (box :orientation "h"
			  :class "${row.Start == current-task.Start && row.Task == current-task.Task ? 'selected' : ''} task-item"
			  (label 
				 :halign "start"
				 :class "pointer"
				 :width 1
				 :truncate "true"
				 :unindent "true"
				 :text "${row.Start == current-task.Start && row.Task == current-task.Task ? '▶' : ' '}")
			  (label :text "${row.Start}"
				 :halign "start")
			  (label :text "${row.Task}"
				 :halign "start")))))

;; ============
;; Main window
;; ============
(defwindow routine
           :monitor 0
           :geometry (geometry :x "0%"
                               :y "20px"
                               :width "80%"
                               :height "90%"
                               :anchor "top center")
           :stacking "bg"
           ;; :reserve (struts :side "top")
           :windowtype "dock"
           :wm-ignore false
           (routine-box))
